{
  "info": {
    "_postman_id": "e08ebb44-43c8-4ffb-8e14-c7511d2f0691",
    "name": "Supabase-RLS-Auth-Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "56012449",
    "_collection_link": "https://go.postman.co/collection/56012449-e08ebb44-43c8-4ffb-8e14-c7511d2f0691?source=collection_link"
  },
  "item": [
    {
      "name": "Anon Requests",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200 with empty array (or 404) when unauthenticated\", function () {\r",
              "    // PostgREST returns 200 with [] or 404 when RLS blocks an update\r",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 404, 401]);\r",
              "    \r",
              "    if (pm.response.code === 200) {\r",
              "        const jsonData = pm.response.json();\r",
              "        pm.expect(jsonData).to.be.an('array').that.is.empty;\r",
              "    }\r",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "protocolProfileBehavior": {
        "disableBodyPruning": true
      },
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "apikey",
            "value": "{{supabase_anon_key}}",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "{{vault:authorization}}",
            "type": "text"
          },
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text",
            "disabled": true
          },
          {
            "key": "Prefer",
            "value": "return=representation",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\r\n    \"email\": \"{{user_email}}\",\r\n    \"password\": \"{{user_password}}\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "https://{{supabase_project_ref}}.supabase.co/rest/v1/games",
          "protocol": "https",
          "host": [
            "{{supabase_project_ref}}",
            "supabase",
            "co"
          ],
          "path": [
            "rest",
            "v1",
            "games"
          ]
        }
      },
      "response": []
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{user_jwt}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "requests": {},
        "exec": [
          "const currentTime = Math.floor(Date.now() / 1000);",
          "const projectRef = pm.globals.get('supabase_project_ref') || pm.environment.get('supabase_project_ref');",
          "const anonKey = pm.globals.get('supabase_anon_key') || pm.environment.get('supabase_anon_key');",
          "const email = pm.globals.get('user_email') || pm.environment.get('user_email');",
          "const password = pm.globals.get('user_password') || pm.environment.get('user_password');",
          "const tokenExpiry = pm.globals.get('token_expiry') || pm.environment.get('token_expiry') || 0;",
          "const userJwt = pm.globals.get('user_jwt') || pm.environment.get('user_jwt');",
          "",
          "if (!userJwt || (tokenExpiry - currentTime) < 300) {",
          "    console.log(\"Token expired or missing. Auto-authenticating with Supabase...\");",
          "",
          "    pm.sendRequest({",
          "        url: `https://${projectRef}.supabase.co/auth/v1/token?grant_type=password`,",
          "        method: 'POST',",
          "        header: {",
          "            'Content-Type': 'application/json',",
          "            'apikey': anonKey",
          "        },",
          "        body: {",
          "            mode: 'raw',",
          "            raw: JSON.stringify({",
          "                email: email,",
          "                password: password",
          "            })",
          "        }",
          "    }, function (err, res) {",
          "        if (!err && res.code === 200) {",
          "            const data = res.json();",
          "            ",
          "            if (pm.environment.name) {",
          "                pm.environment.set(\"user_jwt\", data.access_token);",
          "                pm.environment.set(\"token_expiry\", currentTime + data.expires_in);",
          "            } else {",
          "                pm.globals.set(\"user_jwt\", data.access_token);",
          "                pm.globals.set(\"token_expiry\", currentTime + data.expires_in);",
          "            }",
          "            ",
          "            console.log(\"Auto-refresh successful!\");",
          "        } else {",
          "            const errMsg = err ? err.message : (res ? res.text() : \"Unknown error\");",
          "            console.error(\"Auto-refresh failed:\", errMsg);",
          "        }",
          "    });",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "requests": {},
        "exec": [
          ""
        ]
      }
    }
  ]
}
